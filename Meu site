<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Serviços de informática, manutenção, formatação, impressoras e configuração de rede Wi-Fi." />
  <title>VM Técnico em Informática</title>
  <script>
    // Apply the saved preference before painting the page.
    try {
      document.documentElement.dataset.theme = localStorage.getItem('vm-theme') === 'dark' ? 'dark' : 'light';
    } catch { document.documentElement.dataset.theme = 'light'; }
  </script>
  <style>
    :root {
      --bg: #f5f5f5;
      --surface: #ffffff;
      --surface-soft: #f0f0f0;
      --ink: #0b0b0b;
      --muted: #686868;
      --line: #dddddd;
      --line-strong: #b9b9b9;
      --shadow: 0 18px 48px rgba(0,0,0,.08);
      --radius: 24px;
      --max: 1160px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 10% 10%, rgba(0,0,0,.035) 0 1px, transparent 1.5px) 0 0 / 22px 22px,
        var(--bg);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-align: left;
    }

    a { color: inherit; text-decoration: none; }
    button, input, textarea { font: inherit; }
    img { display: block; max-width: 100%; }

    .container { width: min(calc(100% - 40px), var(--max)); margin-inline: auto; }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 30;
      backdrop-filter: blur(18px);
      background: rgba(245,245,245,.82);
      border-bottom: 1px solid rgba(0,0,0,.06);
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      letter-spacing: -.02em;
    }
    .brand-mark {
      width: 48px;
      height: 48px;
      object-fit: contain;
      object-position: center;
    }
    .brand-copy { display: grid; line-height: 1.05; }
    .brand-copy small { margin-top: 5px; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }

    .nav-links { display: flex; align-items: center; gap: 26px; color: #3e3e3e; font-size: 14px; font-weight: 650; }
    .nav-links a { transition: opacity .2s ease; }
    .nav-links a:hover { opacity: .55; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 20px;
      border-radius: 999px;
      border: 1px solid var(--ink);
      font-weight: 800;
      font-size: 14px;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-dark { background: var(--ink); color: #fff; box-shadow: 0 10px 28px rgba(0,0,0,.14); }
    .btn-light { background: #fff; color: var(--ink); }

    .hero { padding: 78px 0 54px; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 58px; }
    .eyebrow {
      display: inline-flex;
      gap: 9px;
      align-items: center;
      padding: 8px 12px;
      border-radius: 999px;
      background: #fff;
      border: 1px solid var(--line);
      color: #444;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .eyebrow::before { content: ""; width: 7px; height: 7px; background: #111; border-radius: 50%; }

    h1 {
      margin: 22px 0 18px;
      max-width: 760px;
      font-size: clamp(46px, 6vw, 78px);
      line-height: .98;
      letter-spacing: -.055em;
    }
    .hero p {
      margin: 0;
      max-width: 650px;
      color: var(--muted);
      font-size: clamp(17px, 2vw, 20px);
      line-height: 1.65;
    }
    .hero p + p { margin-top: 16px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .hero-meta { display: flex; flex-wrap: wrap; gap: 12px 22px; margin-top: 30px; color: #555; font-size: 13px; font-weight: 650; }
    .hero-meta span { display: inline-flex; align-items: center; gap: 8px; }
    .hero-meta span::before { content: "✓"; color: #000; font-weight: 900; }

    .logo-stage {
      position: relative;
      min-height: 470px;
      border-radius: 34px;
      border: 1px solid #d7d7d7;
      background: linear-gradient(150deg, #fff 0%, #ededed 100%);
      box-shadow: var(--shadow);
      overflow: hidden;
      display: grid;
      place-items: center;
      isolation: isolate;
    }
    .logo-stage::before,
    .logo-stage::after {
      content: "";
      position: absolute;
      border: 1px solid #cfcfcf;
      border-radius: 50%;
      z-index: -1;
    }
    .logo-stage::before { width: 360px; height: 360px; right: -120px; top: -120px; }
    .logo-stage::after { width: 220px; height: 220px; left: -70px; bottom: -80px; }
    .logo-wrap {
      width: 100%;
      padding: 0;
      filter: drop-shadow(0 18px 18px rgba(0,0,0,.10));
    }
    .logo-wrap img { width: 100%; height: auto; transform: scale(1.35); }
    .tech-lines {
      position: absolute;
      inset: 28px 28px auto auto;
      width: 110px;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 9px;
      opacity: .28;
    }
    .tech-lines i { width: 4px; height: 4px; border-radius: 50%; background: #111; }

    .section { padding: 72px 0; }
    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 30px; }
    .section-head h2 { margin: 0; font-size: clamp(34px, 4vw, 54px); letter-spacing: -.04em; line-height: 1.05; }
    .section-head p { margin: 0; max-width: 520px; color: var(--muted); line-height: 1.65; }

    .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .service-card {
      min-height: 170px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 22px;
      padding: 24px;
      display: grid;
      grid-template-columns: 56px 1fr;
      align-items: center;
      gap: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,.035);
      transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
    }
    .service-card:hover { transform: translateY(-3px); border-color: #a7a7a7; box-shadow: 0 16px 34px rgba(0,0,0,.07); }
    .service-icon {
      width: 56px;
      height: 56px;
      border-radius: 17px;
      background: #0a0a0a;
      color: white;
      display: grid;
      place-items: center;
    }
    .service-icon svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 1.8; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .service-card h3 { margin: 0 0 8px; font-size: 18px; line-height: 1.25; letter-spacing: -.015em; }
    .service-card p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
    .price { padding-left: 10px; white-space: nowrap; font-size: 20px; font-weight: 900; letter-spacing: -.03em; }
    .price small { display: block; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 4px; }

    .payment {
      margin-top: 20px;
      padding: 16px 20px;
      border-radius: 18px;
      background: #0a0a0a;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }
    .payment strong { font-size: clamp(17px, 2vw, 22px); letter-spacing: -.025em; }
    .payment p { margin: 4px 0 0; color: #bdbdbd; font-size: 12px; }
    .card-icon { width: 48px; height: 34px; border: 2px solid #fff; border-radius: 8px; position: relative; flex: 0 0 auto; }
    .card-icon::before { content: ""; position: absolute; left: 0; right: 0; top: 10px; height: 2px; background: #fff; }
    .card-icon::after { content: ""; position: absolute; left: 8px; bottom: 8px; width: 18px; height: 3px; border-radius: 3px; background: #fff; }

    .why {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 18px;
    }
    .why-main {
      background: #0a0a0a;
      color: #fff;
      border-radius: 28px;
      padding: 38px;
      min-height: 360px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .why-main .mini { color: #aaa; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .why-main h2 { margin: 16px 0 0; font-size: clamp(34px, 4.5vw, 58px); line-height: 1.02; letter-spacing: -.045em; }
    .why-main p { margin: 30px 0 0; color: #c8c8c8; line-height: 1.7; }
    .why-photo { position: relative; margin: 0; min-height: 360px; overflow: hidden; border-radius: 28px; background: #111; }
    .why-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }

    .contact-card {
      position: relative;
      overflow: hidden;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 30px;
      padding: 42px;
      box-shadow: var(--shadow);
    }
    .contact-card::after {
      content: "VM";
      position: absolute;
      right: -16px;
      bottom: -56px;
      font-size: 220px;
      font-weight: 950;
      letter-spacing: -.12em;
      color: #f0f0f0;
      z-index: 0;
      pointer-events: none;
    }
    .contact-content { position: relative; z-index: 1; max-width: none; }
    .contact-card h2 { margin: 0 0 14px; font-size: clamp(38px, 5vw, 62px); letter-spacing: -.045em; line-height: 1.03; }
    .contact-card p { margin: 0; color: var(--muted); line-height: 1.65; font-size: 17px; }
    .contact-details {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
      grid-auto-rows: 1fr;
      gap: 12px;
      margin-top: 26px;
    }
    .contact-link {
      width: 100%;
      min-width: 0;
      min-height: 112px;
      padding: 18px 20px;
      box-sizing: border-box;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: #fafafa;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: left;
      transition: transform .2s ease, border-color .2s ease, background .2s ease;
    }
    .contact-link:hover { transform: translateY(-2px); border-color: #aaa; background: #fff; }
    .contact-label { color: var(--muted); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .contact-link strong {
      max-width: 100%;
      margin-top: 6px;
      font-size: clamp(14px, 1.25vw, 17px);
      line-height: 1.3;
      letter-spacing: -.02em;
      white-space: nowrap;
    }
    .contact-hint { margin-top: 7px; color: #777; font-size: 12px; font-weight: 650; }

    .coverage-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .coverage-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 22px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(0,0,0,.035);
    }
    .coverage-card .tag {
      display: inline-flex;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #f8f8f8;
      color: #555;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .coverage-card h3 { margin: 18px 0 10px; font-size: 24px; letter-spacing: -.03em; }
    .coverage-card p { margin: 0; color: var(--muted); line-height: 1.65; font-size: 14px; }

    .contact-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      align-items: start;
    }
    .form-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 30px;
      padding: 32px;
      box-shadow: var(--shadow);
    }
    .form-card h3 { margin: 0 0 10px; font-size: 30px; letter-spacing: -.03em; }
    .form-card p { margin: 0 0 22px; color: var(--muted); line-height: 1.65; }
    .contact-form {
      display: grid;
      gap: 14px;
    }
    .contact-form label {
      display: grid;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: #383838;
    }
    .contact-form input,
    .contact-form select,
    .contact-form textarea {
      width: 100%;
      padding: 14px 16px;
      border-radius: 16px;
      border: 1px solid var(--line);
      background: #fafafa;
      color: var(--ink);
      outline: none;
      transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
    }
    .contact-form input:focus,
    .contact-form select:focus,
    .contact-form textarea:focus {
      border-color: #969696;
      background: #fff;
      box-shadow: 0 0 0 4px rgba(0,0,0,.04);
    }
    .contact-form textarea { min-height: 140px; resize: vertical; }
    .form-note { margin-top: 14px; color: #7b7b7b; font-size: 12px; line-height: 1.6; }

    footer { padding: 28px 0 42px; color: #777; font-size: 13px; }
    .footer-row { display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid var(--line); padding-top: 24px; }

    @media (max-width: 1100px) {
      .contact-layout { grid-template-columns: 1fr; }
    }

    @media (max-width: 940px) {
      .nav-links { display: none; }
      .hero { padding-top: 48px; }
      .hero-grid, .why, .contact-layout, .coverage-grid { grid-template-columns: 1fr; }
      .why-photo { min-height: 0; aspect-ratio: 16 / 9; }
      .logo-stage { min-height: 360px; order: -1; }
      .services-grid { grid-template-columns: 1fr; }
      .section-head { align-items: start; flex-direction: column; }
    }

    @media (max-width: 620px) {
      .container { width: min(calc(100% - 24px), var(--max)); }
      .nav { min-height: 68px; }
      .brand-copy { display: none; }
      .site-header .btn { min-height: 42px; padding-inline: 15px; }
      .hero { padding: 34px 0 32px; }
      .logo-stage { min-height: 285px; border-radius: 24px; }
      .logo-wrap { width: 100%; padding: 0; }
      .section { padding: 54px 0; }
      .service-card { min-height: 0; grid-template-columns: 50px 1fr; padding: 20px; }
      .service-icon { width: 50px; height: 50px; border-radius: 15px; }
      .price { grid-column: 2; padding-left: 0; margin-top: 2px; font-size: 19px; }
      .price small { display: none; }
      .payment { align-items: flex-start; flex-direction: column-reverse; }
      .why-main, .contact-card { padding: 28px; }
      .contact-details { grid-template-columns: 1fr; }
      .contact-card::after { font-size: 150px; bottom: -30px; }
      .footer-row { flex-direction: column; }
    }
    :root { color-scheme: light; }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #121212;
      --surface: #202020;
      --surface-soft: #292929;
      --ink: #f3f3f3;
      --muted: #bcbcbc;
      --line: #444;
      --line-strong: #777;
      --shadow: 0 18px 48px rgba(0,0,0,.3);
    }
    .nav-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .theme-toggle {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      min-width: 44px; min-height: 44px; padding: 10px 12px;
      background: var(--surface); color: var(--ink); border: 1px solid var(--line);
      border-radius: 999px; cursor: pointer; font-size: 13px; font-weight: 700;
    }
    .theme-toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .theme-toggle .sun-icon { display: none; }
    [data-theme="dark"] .theme-toggle .sun-icon { display: block; }
    [data-theme="dark"] .theme-toggle .moon-icon { display: none; }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
    [data-theme="dark"] .site-header { background: rgba(18,18,18,.94); border-color: var(--line); }
    [data-theme="dark"] .nav-links,
    [data-theme="dark"] .hero-meta,
    [data-theme="dark"] .contact-hint,
    [data-theme="dark"] footer { color: var(--muted); }
    [data-theme="dark"] .btn-dark { color: #121212; }
    [data-theme="dark"] .btn-light,
    [data-theme="dark"] .eyebrow,
    [data-theme="dark"] .contact-card,
    [data-theme="dark"] .coverage-card { background: var(--surface); color: var(--ink); }
    [data-theme="dark"] .contact-link,
    [data-theme="dark"] .coverage-card .tag { background: var(--surface-soft); color: var(--ink); }
    [data-theme="dark"] .contact-link:hover { background: #333; border-color: #888; }
    [data-theme="dark"] .contact-card::after { color: #2a2a2a; }
    [data-theme="dark"] .hero-meta span::before { color: var(--ink); }
    [data-theme="dark"] .eyebrow::before { background: var(--ink); }
    /* Invert only the logos in dark mode; keep photos and the light theme unchanged. */
    [data-theme="dark"] .brand-mark,
    [data-theme="dark"] .logo-wrap img { filter: invert(1); }
    [data-theme="dark"] .logo-stage {
      background: linear-gradient(150deg, #202020 0%, #121212 100%);
      border-color: var(--line);
    }
    [data-theme="dark"] .logo-stage::before,
    [data-theme="dark"] .logo-stage::after { border-color: var(--line); }
    [data-theme="dark"] .tech-lines i { background: var(--ink); }
    [data-theme="dark"] .payment,
    [data-theme="dark"] .why-main { box-shadow: inset 0 0 0 1px var(--line); }
    @media (max-width: 1100px) { .nav-links { gap: 14px; } .nav { gap: 12px; } }
    @media (max-width: 620px) { .theme-toggle .theme-label { display: none; } .nav-actions { gap: 8px; } }
    /* Show only the logo, without a panel or decorative elements in either theme. */
    .logo-stage,
    [data-theme="dark"] .logo-stage {
      background: transparent;
      border: 0;
      box-shadow: none;
      border-radius: 0;
    }
    .logo-stage::before,
    .logo-stage::after,
    .logo-stage .tech-lines { display: none; }
    .logo-wrap { filter: none; }
    /* Shared type scale keeps equivalent headings consistent across sections. */
    :root {
      --title-size: clamp(2rem, 3.8vw, 2.75rem);
      --subtitle-size: clamp(1.125rem, 1.8vw, 1.375rem);
    }
    h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -.04em; }
    .section-head h2, .why-main h2, .contact-card h2 {
      font-size: var(--title-size); line-height: 1.15; letter-spacing: -.035em; font-weight: 800;
    }
    .service-card h3, .coverage-card h3, .payment strong {
      font-size: var(--subtitle-size); line-height: 1.3; letter-spacing: -.02em; font-weight: 750;
    }
    .hero p, .section-head p, .why-main p, .contact-card p,
    .service-card p, .coverage-card p { font-size: 1rem; line-height: 1.65; }
    .eyebrow, .why-main .mini, .coverage-card .tag {
      font-size: .75rem; line-height: 1.4; letter-spacing: .08em; font-weight: 800;
    }
    .hero, #pagamentos { position: relative; isolation: isolate; }
    .hero::before, #pagamentos::before {
      content: ""; position: absolute; top: 8px; right: 0;
      width: min(46%, 420px); aspect-ratio: 360 / 160;
      background: var(--ink); opacity: .22;
      -webkit-mask: url("assets/circuitos.svg") center / contain no-repeat;
      mask: url("assets/circuitos.svg") center / contain no-repeat;
      pointer-events: none; z-index: -1;
    }
    [data-theme="dark"] .hero::before,
    [data-theme="dark"] #pagamentos::before { opacity: .18; }
    @media (max-width: 620px) {
      .hero::before, #pagamentos::before { width: 48%; opacity: .12; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="#inicio" aria-label="VM Técnico em Informática">
        <img class="brand-mark" src="data:image/png;base64," alt="Logo VM Técnico em Informática" />
        <span class="brand-copy">VM <small>Técnico em Informática</small></span>
      </a>
      <nav class="nav-links" aria-label="Navegação principal">
        <a href="#servicos">Serviços</a>
        <a href="#diferenciais">Diferenciais</a>
        <a href="#atendimento">Atendimento</a>
        <a href="#contato">Contato</a>
      </nav>
      <div class="nav-actions">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Modo escuro" aria-pressed="false" title="Alternar modo claro e escuro">
          <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/></svg>
          <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <span class="theme-label">Modo escuro</span>
        </button>
        <a class="btn btn-dark" href="https://wa.me/5519997368303?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento." target="_blank" rel="noopener noreferrer">Solicitar orçamento</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div>
